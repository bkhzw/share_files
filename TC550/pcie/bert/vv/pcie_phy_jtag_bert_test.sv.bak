      reg_data[1] = 1'b0; //phy_laneX_rx2tx_par_lb_en 
      reg_data[0] = 1'b1; //phy_laneX_tx2rx_par_lb_en 
      reg_data[2] = 1'b1; //overide en
      jtag_cr_write(pn, 'h1000+'h200*ln, reg_data);
      `uvm_info(get_full_name(),$sformatf("tx2rx loopback en by jtag"),UVM_LOW)
      //end
      //RAWLANEN_DIG_PCS_XF_LANE_OVRD_IN
      jtag_cr_read(pn, 'h2028+'h200*ln, reg_data);
      reg_data[2] = 1'b1; //LANE_TX2RX_SER_LB_EN_OVRD_VAL
      reg_data[0] = 1'b0; //LANE_RX2TX_PAR_LB_EN_OVRD_VAL
      reg_data[3] = 1'b1; //LANE_TX2RX_SER_LB_EN_OVRD_EN
      reg_data[1] = 1'b1; //LANE_RX2TX_PAR_LB_EN_OVRD_EN
      jtag_cr_write(pn, 'h2028+'h200*ln, reg_data);
      `uvm_info(get_full_name(),$sformatf("tx2rx loopback en by jtag"),UVM_LOW)

   endtask

   task bert_test_per_lane(bit[1:0] pn, bit[1:0] ln);
      bit[15:0] read_data,write_data;
      bit[3:0] bert_mode;
      bit[31:0] Pattern;
      bit trigger_error = 1'b1;
      uvm_status_e        status;
      uvm_reg             pcie_phy_reg;
      uvm_reg_data_t      reg_data;


      //LANEN_DIG_ASIC_RX_OVRD_IN_0
      jtag_cr_read(pn, 'h1020+'h200*ln, reg_data);
      reg_data[4] = 1'b1; //rx_data_en 
      jtag_cr_write(pn, 'h1020+'h200*ln, reg_data);

      jtag_cr_read(pn, 'h1020+'h200*ln, reg_data);
      reg_data[5] = 1'b1; //overide en
      jtag_cr_write(pn, 'h1020+'h200*ln, reg_data);

      //bert_mode = $urandom_range(1,13);
      bert_mode = 1;

      //bert tx ctrl
      if(bert_mode == 9 || bert_mode == 11)
         write_data[14:5] = $urandom_range(1,1022);
      else if(bert_mode == 10) 
         write_data[14:5] = $urandom_range(1023);
      write_data[3:0] = bert_mode;
      jtag_cr_write(pn, 'h1071+'h200*ln, write_data);
      if(bert_mode == 2) begin
         jtag_cr_write(pn, 'h1072+'h200*ln, $urandom_range(16'hffff));
         jtag_cr_write(pn, 'h1073+'h200*ln, $urandom_range(16'hffff));
         jtag_cr_write(pn, 'h1074+'h200*ln, $urandom_range(16'hffff));
         jtag_cr_write(pn, 'h1075+'h200*ln, $urandom_range(16'hffff));
      end
      //bert rx ctrl
      write_data = 0;
      write_data[3:0] = bert_mode;
      jtag_cr_write(pn, 'h1093+'h200*ln, write_data);
      //clear err cnt
      write_data[4] = 0; //sync
      jtag_cr_write(pn, 'h1093+'h200*ln, write_data);
      write_data[4] = 1; //sync
      jtag_cr_write(pn, 'h1093+'h200*ln, write_data);
      write_data[4] = 0; //sync
      jtag_cr_write(pn, 'h1093+'h200*ln, write_data);
      write_data[4] = 1; //sync
      jtag_cr_write(pn, 'h1093+'h200*ln, write_data);
      write_data[4] = 0; //sync
      jtag_cr_write(pn, 'h1093+'h200*ln, write_data);
      //10us refer to ate_run_bert_test
      //LANEN_DIG_RX_LBERT_ERR
      jtag_cr_read(pn, 'h1094+'h200*ln, reg_data);
      if(reg_data != 0)
         `uvm_error(get_full_name(),$sformatf("bert check error : phy%0d lane%0d bert match error status(0x%0x)!",pn,ln,reg_data))
      `uvm_info(get_full_name(),$sformatf("phy%0d lane %0d begin to inject error",pn,ln),UVM_LOW)
      jtag_cr_read(pn, 'h1071+'h200*ln, write_data);
      write_data[4] = 1;
      jtag_cr_write(pn, 'h1071+'h200*ln, write_data);
      write_data[4] = 0;
      jtag_cr_write(pn, 'h1071+'h200*ln, write_data);

      #10us;
      jtag_cr_read(pn, 'h1094+'h200*ln, reg_data);
      if(reg_data != 1)
         `uvm_error(get_full_name(),$sformatf("bert check error : phy%0d lane%0d bert match error status(0x%0x)!",pn,ln,reg_data))

      jtag_cr_write(pn, 'h1071+'h200*ln, 0);
      jtag_cr_write(pn, 'h1020+'h200*ln, 0);
      jtag_cr_write(pn, 'h1093+'h200*ln, 0);
   endtask
endclass

`endif
