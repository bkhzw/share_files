      //RAWLANEX_DIG_PCS_XF_ATE_OVRD_IN
      jtag_cr_read(pn, 'h2020+'h200*ln, reg_data);
      reg_data[0] = 1'b1; //RX_RESET_ATE_OVRD_VAL
      reg_data[1] = 1'b1; //RX_RESET_ATE_OVRD_EN
      reg_data[2] = 1'b1; //TX_RESET_ATE_OVRD_VAL
      reg_data[3] = 1'b1; //TX_RESET_ATE_OVRD_EN
      `uvm_info(get_full_name(),$sformatf("Override per lane resets to 1 phy%0d lane%0d",pn,ln),UVM_LOW)
      reg_data[4] = 1'b0; //RX_REQ_ATE_OVRD_VAL
      reg_data[5] = 1'b1; //RX_REQ_ATE_OVRD_EN
      reg_data[6] = 1'b0; //TX_REQ_ATE_OVRD_VAL
      reg_data[7] = 1'b1; //TX_REQ_ATE_OVRD_EN
      reg_data[14] = 1'b0; //RX_DATA_EN_ATE_OVRD_VAL
      reg_data[15] = 1'b1; //RX_DATA_EN_ATE_OVRD_EN
      `uvm_info(get_full_name(),$sformatf("Override tx_req, rx_req, and rx_data_en to 0 phy%0d lane%0d",pn,ln),UVM_LOW)
      jtag_cr_write(pn, 'h2020+'h200*ln, reg_data);
      `uvm_info(get_full_name(),$sformatf("phy%0d RAWLANE%0d_DIG_PCS_XF_ATE_OVRD_IN ",pn,ln),UVM_LOW)

      //from ate_initialize_test

