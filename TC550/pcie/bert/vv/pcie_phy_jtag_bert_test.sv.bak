      //                #10us;

      //DIG_PCS_XF_RX_PCS_OUT
      jtag_cr_read(pn, 'h2019+'h200*ln, reg_data);
      if(reg_data[0] != 0)
         `uvm_error(get_full_name(),$sformatf("Expecting RX ACK(bit[0]) to be de-asserted on phy%0d lane%0d",pn,ln))

      //DIG_PCS_XF_TX_PCS_OUT
      jtag_cr_read(pn, 'h2004+'h200*ln, reg_data);
      if(reg_data[0] != 0)
         `uvm_error(get_full_name(),$sformatf("Expecting TX ACK(bit[0]) to be de-asserted on phy%0d lane%0d",pn,ln))

      `uvm_info(get_full_name(),$sformatf("rx_pstate go to P0 state phy%0d",pn),UVM_LOW)
      fork
         while(1) begin
            bit[1:0] hdl_data;
            void'(uvm_hdl_read({`DV_STRINGIFY(`PCIE_TOP),$sformatf(".pcie_core_0.pcie_phy_pipe_0.u_dwc_e32mp_upcs_x4_ns_x16_x4x4x4x4_pipe.phy%0d.rx%0d_pstate",pn,ln)}, hdl_data));
            if(hdl_data == 0) break;
            rx_pstate_cnt++;
            if(rx_pstate_cnt%100 == 0)
               `uvm_info(get_full_name(),$sformatf("phy%0d lane%0d rx still wait P0 state",pn,ln),UVM_LOW)
            #10ns;
         end
         while(1) begin
            bit[1:0] hdl_data;
            void'(uvm_hdl_read({`DV_STRINGIFY(`PCIE_TOP),$sformatf(".pcie_core_0.pcie_phy_pipe_0.u_dwc_e32mp_upcs_x4_ns_x16_x4x4x4x4_pipe.phy%0d.tx%0d_pstate",pn,ln)}, hdl_data));
            if(hdl_data == 0) break;
            rx_pstate_cnt++;
            if(tx_pstate_cnt%100 == 0)
               `uvm_info(get_full_name(),$sformatf("phy%0d lane%0d tx still wait P0 state",pn,ln),UVM_LOW)
            #10ns;
         end
      join


      //loopback enable
