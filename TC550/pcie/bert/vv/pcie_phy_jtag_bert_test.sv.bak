      //RAWLANEN_DIG_PCS_XF_LANE_CNTX_OVRD_1
      jtag_cr_read(pn, 'h206c+'h200*ln, reg_data);
      reg_data[9] = 1'b1; //LANE_CNTX_EN_I_OVRD_VAL
      jtag_cr_write(pn, 'h206c+'h200*ln, reg_data);

      jtag_cr_read(pn, 'h206c+'h200*ln, reg_data);
      reg_data[10] = 1'b1; //LANE_CNTX_EN_I_OVRD_EN
      jtag_cr_write(pn, 'h206c+'h200*ln, reg_data);
      `uvm_info(get_full_name(),$sformatf("Overriding lane_cntx_en_o phy%0d lane%0d",pn,ln),UVM_LOW)

      //RAWCMN_DIG_AON_ATE_MODE_EN
      jtag_cr_read(pn, 'h19d, reg_data);
      reg_data[0] = 1'b1; //ATE_MODE_EN
      jtag_cr_write(pn, 'h19d, reg_data);
      `uvm_info(get_full_name(),$sformatf("Enable ate mode phy%0d",pn),UVM_LOW)

      //RAWCMN_DIG_TOKEN_DLY
      jtag_cr_read(pn, 'h133, reg_data);
      reg_data[2:0] = 3'b000; //RAWCMN_DIG_TOKEN_DLY_VAL
      jtag_cr_write(pn, 'h133, reg_data);
      `uvm_info(get_full_name(),$sformatf("Overriding TOKEN_DLY phy%0d",pn),UVM_LOW)

      //tx_data_en,rx_data_en input could not be control, the signal was from the pipe interface, so config cr reg is the only option
      //LANEN_DIG_ASIC_TX_OVRD_IN_0
      jtag_cr_read(pn, 'h1001+'h200*ln, reg_data);
      reg_data[7:6] = 2'b0; //tx_data_en 
