      jtag_cr_read(pn, 'h1001+'h200*ln, reg_data);
      reg_data[8] = 1'b1; //overide en
      jtag_cr_write(pn, 'h1001+'h200*ln, reg_data);
      `uvm_info(get_full_name(),$sformatf("De-asserting pma tx_data_en to 0 phy%0d lane%0d",pn,ln),UVM_LOW)

